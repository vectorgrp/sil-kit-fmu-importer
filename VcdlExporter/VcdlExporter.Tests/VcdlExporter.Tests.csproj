<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <FmuImporterSolutionDir>../../FmuImporter</FmuImporterSolutionDir>
  </PropertyGroup>

  <Import Project="$(FmuImporterSolutionDir)/build.props" />

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.4.2" />
    <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
    <PackageReference Include="coverlet.collector" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exporter is also started as a separate process (see ExporterRunner); both projects share the output directory -->
    <ProjectReference Include="..\VcdlExporter\VcdlExporter.csproj" />
  </ItemGroup>

  <Target Name="CopyTestFixtures" AfterTargets="Build">
    <ItemGroup>
      <TestFixtures Include="$(MSBuildProjectDirectory)/Fixtures/**/*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(TestFixtures)"
      DestinationFolder="$(OutputPath)Fixtures/%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
