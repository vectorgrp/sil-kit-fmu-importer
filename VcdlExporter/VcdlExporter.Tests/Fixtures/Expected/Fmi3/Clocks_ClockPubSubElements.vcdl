version 2.0;
import module "SilKit";

namespace Clocks
{
  [Binding="SilKit"]
  interface IClocks
  {
    provided data int32 clocked_input;
    provided data bool inTriggeredClock;

    consumed data double unclocked_output;
    consumed data int32 clocked_output;
    consumed data bool outTriggeredClock;
  }
  IClocks Clocks;
}
